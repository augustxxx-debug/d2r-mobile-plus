// 无格式存储图像写（StorageImageWriteWithoutFormat）| formatless storage image write
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform writeonly image2D img;
void main() { ivec2 p = ivec2(gl_GlobalInvocationID.xy); imageStore(img, p, vec4(float(p.x) / 64.0, float(p.y) / 64.0, 0.5, 1.0)); }
