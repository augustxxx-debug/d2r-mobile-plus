<?xml version="1.0" encoding="utf-8"?>
<!-- 两个权限：所有文件访问（读玩家放在 Download/S2X/D2R Mobile/data 的游戏资源）；网络（只在首次导入 / 生成的加载页上读一次远端的小清单 latest.json，
     给页脚的官方免费渠道用，CommunityFetch.java；只用 https、包里没配地址就不联网；普通启动、游戏里都不联网）。不要别的权限。 -->
<!-- Two permissions: all files access (to read the game resources the player puts in Download/S2X/D2R Mobile/data); network (only on the first import / generation
     loading page, to read one small remote manifest latest.json for the footer's official free channels, CommunityFetch.java; https only, and no network access when the
     package has no address; never on a normal start or in game). No other permissions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <application
        android:label="@string/dmAndroidName"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasFragileUserData="true"
        android:appCategory="game"
        android:isGame="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name=".DmActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:resizeableActivity="false"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 分享诊断日志：只开放 files/share/ 的只读 content://，不导出，靠 Intent 临时授权 | share diagnostics: read-only content:// for files/share/ only, not exported, temporary grant via the Intent -->
        <provider android:name=".DiagProvider" android:authorities="${applicationId}.diag" android:exported="false" android:grantUriPermissions="true" />
        <receiver android:name=".widget.HeroWidget2x2Provider"
            android:exported="false" android:label="@string/dmAndroidWidgetName2x2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_2x2_info" />
            <meta-data android:name="vivo_widget" android:value="true" />
            <meta-data android:name="vivoWidgetVersion" android:value="1" />
            <meta-data android:name="vivo.widget.description" android:resource="@string/dmAndroidWidgetDescription" />
        </receiver>
        <receiver android:name=".widget.HeroWidget4x2Provider"
            android:exported="false" android:label="@string/dmAndroidWidgetName4x2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_4x2_info" />
            <meta-data android:name="vivo_widget" android:value="true" />
            <meta-data android:name="vivoWidgetVersion" android:value="1" />
            <meta-data android:name="vivo.widget.description" android:resource="@string/dmAndroidWidgetDescription" />
        </receiver>
    </application>
</manifest>
